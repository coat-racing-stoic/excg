          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/rates/fixed",
              "host": ["{{base_url}}"],
              "path": ["api", "rates", "fixed"]
            },
            "description": "Get all fixed exchange rates in JSON format. No authentication required."
          },
          "response": []
