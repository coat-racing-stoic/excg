            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/api/v2/ccies",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "ccies"]
            },
            "description": "Example of request with invalid signature."
          },
          "response": [
            {
              "name": "Invalid Signature",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"code\": 401,\n  \"msg\": \"Invalid API signature\",\n  \"data\": null\n}"
            }
          ]
        }
      ]
    }
  ]
}
