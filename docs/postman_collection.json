              "path": ["api", "rates", "float"]
            },
            "description": "Get all floating exchange rates in JSON format. No authentication required."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authenticated Endpoints",
      "description": "Endpoints that require X-API-KEY and X-API-SIGN headers",
      "item": [
        {
          "name": "Get Currencies",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/api/v2/ccies",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "ccies"]
            },
            "description": "Get list of all supported cryptocurrencies.\n\n**Weight:** 1 unit\n**Authentication:** Required"
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"code\": 0,\n  \"msg\": \"Success\",\n  \"data\": [\n    {\n      \"code\": \"BTC\",\n      \"name\": \"Bitcoin\",\n      \"network\": \"BTC\",\n      \"coin\": \"BTC\"\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Get Exchange Rate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromCcy\": \"BTC\",\n  \"toCcy\": \"ETH\",\n  \"amount\": 0.1,\n  \"direction\": \"from\",\n  \"type\": \"fixed\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v2/price",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "price"]
            },
            "description": "Calculate exchange rate for a currency pair.\n\n**Parameters:**\n- `fromCcy`: Source currency code (e.g., BTC)\n- `toCcy`: Target currency code (e.g., ETH)\n- `amount`: Amount to exchange\n- `direction`: \"from\" or \"to\"\n- `type`: \"fixed\" or \"float\"\n\n**Weight:** 1 unit\n**Authentication:** Required"
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"code\": 0,\n  \"msg\": \"Success\",\n  \"data\": {\n    \"exchange_rate\": {\n      \"from_rate\": {\n        \"code\": \"BTC\",\n        \"amount\": \"0.1\",\n        \"rate\": \"29.1347852\"\n      },\n      \"to_rate\": {\n        \"code\": \"ETH\",\n        \"amount\": \"2.9133506\",\n        \"rate\": \"0.0336204\"\n      }\n    }\n  }\n}"
            }
          ]
        },
        {
          "name": "Get Exchange Rate (with Partner)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromCcy\": \"BTC\",\n  \"toCcy\": \"ETH\",\n  \"amount\": 0.1,\n  \"direction\": \"from\",\n  \"type\": \"fixed\",\n  \"refcode\": \"PARTNER001\",\n  \"afftax\": 2.5\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v2/price",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "price"]
            },
            "description": "Calculate exchange rate with partner commission.\n\n**Additional Parameters:**\n- `refcode`: Partner referral code\n- `afftax`: Partner commission percentage (0-100)\n\n**Weight:** 1 unit\n**Authentication:** Required"
          },
          "response": []
        },
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromCcy\": \"BTC\",\n  \"toCcy\": \"ETH\",\n  \"amount\": 0.1,\n  \"direction\": \"from\",\n  \"type\": \"fixed\",\n  \"toAddress\": \"0x742d35Cc6634C0532925a3b8D4C9db96C4b4d8b6\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v2/create",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "create"]
            },
            "description": "Create a new exchange order.\n\n**Parameters:**\n- `fromCcy`: Source currency code\n- `toCcy`: Target currency code\n- `amount`: Amount to exchange\n- `direction`: \"from\" or \"to\"\n- `type`: \"fixed\" or \"float\"\n- `toAddress`: Destination wallet address\n\n**Weight:** 50 units\n**Authentication:** Required"
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"code\": 0,\n  \"msg\": \"Success\",\n  \"data\": {\n    \"id\": \"ORDER_ID\",\n    \"token\": \"ORDER_TOKEN\",\n    \"status\": \"NEW\",\n    \"from\": {\n      \"code\": \"BTC\",\n      \"amount\": \"0.1\",\n      \"address\": \"bc1q...\"\n    },\n    \"to\": {\n      \"code\": \"ETH\",\n      \"amount\": \"2.91\",\n      \"address\": \"0x742d35...\"\n    }\n  }\n}"
            }
          ]
        },
        {
          "name": "Get Order Status",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"ORDER_ID\",\n  \"token\": \"ORDER_TOKEN\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v2/order",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "order"]
            },
            "description": "Get the current status of an order.\n\n**Parameters:**\n- `id`: Order ID\n- `token`: Order token\n\n**Weight:** 1 unit\n**Authentication:** Required"
          },
          "response": []
        },
