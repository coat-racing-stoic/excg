              "raw": "{\n  \"id\": \"ORDER_ID\",\n  \"token\": \"ORDER_TOKEN\",\n  \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v2/setEmail",
              "host": ["{{base_url}}"],
