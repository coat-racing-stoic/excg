# FixedFloat API Configuration
# Copy this file to .env and fill in your values

# API Configuration (required - get from https://fixedfloat.com/api)
FIXEDFLOAT_API_KEY=your_api_key_here
FIXEDFLOAT_API_SECRET=your_api_secret_here

# Server Configuration
HOST=0.0.0.0
PORT=12000
DEBUG=false

# Logging
LOG_LEVEL=INFO
LOG_DIR=/app/logs

# Redis Configuration (for rate limiting and caching)
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change_this_to_a_random_secret_key
ALGORITHM=HS256

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=250
RATE_LIMIT_CREATE_ORDER_WEIGHT=50
RATE_LIMIT_DEFAULT_WEIGHT=1

# Rates Caching Configuration
RATES_CACHE_ENABLED=true
RATES_UPDATE_INTERVAL=20
RATES_CACHE_TTL=60